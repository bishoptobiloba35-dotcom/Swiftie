NODE_ENV=production
API_PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/swiftdrop
JWT_SECRET=replace-with-a-long-random-secret
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=replace-with-paystack-secret
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
MAPS_PROVIDER=google
MAPS_API_KEY=replace-with-server-side-maps-key
PUBLIC_API_URL=https://api.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=swiftdrop-private
CORS_ORIGINS=https://admin.example.com
DRIVER_PAYOUT_PERCENT=90
EXPO_PUSH_ACCESS_TOKEN=replace-only-if-enhanced-expo-push-security-is-enabled
