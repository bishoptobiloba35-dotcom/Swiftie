# API
API_PORT=4000
DATABASE_URL=
CORS_ORIGINS=https://api.example.com

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Maps
MAPS_PROVIDER=google
MAPS_API_KEY=

# Payments
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
DRIVER_PAYOUT_PERCENT=90

# Private object storage (S3-compatible; required in production)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT=
LOCAL_PRIVATE_STORAGE_DIR=uploads/private

# Sensitive delivery modes stay disabled until both the feature flag and its
# separately reviewed legal gate are approved. Never set these to true merely
# to make a route available.
SWIFTDROP_ENABLE_RECEIVER_ESCROW=false
SWIFTDROP_LEGAL_GATE_LICENSED_ESCROW_PARTNER=false
SWIFTDROP_ENABLE_STANDARD_DELIVERY=false
SWIFTDROP_LEGAL_GATE_STATION_AGENT_LIABILITY=false

# Operations
# Set a long random secret; /metrics returns 404 unless this bearer token matches.
METRICS_TOKEN=
